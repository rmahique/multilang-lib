# Contributor: Raúl Mahiques <claude.ia@raulmahiques.com>
# Maintainer: Raúl Mahiques <claude.ia@raulmahiques.com>
pkgname=multilang-devel
# build-apk.sh exports MULTILANG_VERSION before invoking abuild; 0.1.0
# here is only a fallback for anyone invoking abuild directly.
pkgver=${MULTILANG_VERSION:-0.1.0}
pkgrel=0
pkgdesc="Reusable multi-language string storage library (Go source)"
url="https://github.com/rmahique/multilang-lib"
arch="noarch"
license="GPL-3.0-or-later"
depends="go"
# No source= URL and no compiled artifact -- Go isn't normally
# distro-packaged as a library, consumers `go build`/`go get` against
# source (see ../../README.md). build-apk.sh stages this package's own
# *.go/go.mod/go.sum/LICENSE alongside this APKBUILD before invoking
# abuild, same staging approach as every other language's build-apk.sh.
source=""
builddir="$startdir"
options="!fetch !check"

package() {
	dest="$pkgdir/usr/share/gocode/src/github.com/rmahique/multilang-lib/go"
	install -d "$dest"
	cp -r *.go go.mod go.sum "$dest"/
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}
