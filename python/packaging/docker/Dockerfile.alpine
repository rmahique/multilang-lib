# Packaging build image for python-alpine. Bakes in every dependency
# packaging/build-apk.sh needs, on the same distro the package targets --
# generated from (and must be kept in sync with) the combo definition in
# ../../../.github/workflows/build-packages.yml.
#
# Unlike the .deb/.rpm images, Alpine's own tooling (abuild) refuses to
# run its actual build/package steps as root -- see packaging/README.md's
# "Alpine" section for why this Dockerfile creates a `builder` user and
# an ephemeral signing key instead of just `apk add`-ing and building
# directly, the way every other Dockerfile in this repo does.
FROM alpine:3.20

# bash: Alpine's default shell is busybox ash, not bash -- both
# build-packages.yml's `docker run ... bash -c '...'` step and
# build-apk.sh's own `#!/usr/bin/env bash` shebang need a real bash on
# PATH, unlike every other (Debian/Fedora/openSUSE/SLES) Dockerfile in
# this repo where bash is already the default shell.
RUN apk add --no-cache alpine-sdk sudo bash python3 python3-dev py3-setuptools py3-build py3-installer py3-wheel py3-pytest tar git && \
    adduser -D builder && \
    addgroup builder abuild && \
    echo 'builder ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/builder && \
    su builder -c 'abuild-keygen -a -i -n'
