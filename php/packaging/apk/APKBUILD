# Contributor: Raúl Mahiques <claude.ia@raulmahiques.com>
# Maintainer: Raúl Mahiques <claude.ia@raulmahiques.com>
pkgname=php-multilang
# build-apk.sh exports MULTILANG_VERSION before invoking abuild; 0.1.0
# here is only a fallback for anyone invoking abuild directly.
pkgver=${MULTILANG_VERSION:-0.1.0}
pkgrel=0
pkgdesc="Reusable multi-language string storage library (PHP source)"
url="https://github.com/rmahique/multilang-lib"
arch="noarch"
license="GPL-3.0-or-later"
depends="php83 php83-pdo"
# No source= URL: ships as plain PSR-4 source under
# /usr/share/php/Multilang/, wrapping this project's Composer package --
# same convention as ../../debian/rules and ../../rpm/php-multilang.spec.
# The specific PDO driver needed (php83-pdo_sqlite, php83-pdo_pgsql,
# php83-pdo_mysql) is deliberately not a depends, for the same reason
# those two files give. build-apk.sh stages src/ and composer.json
# alongside this APKBUILD before invoking abuild.
source=""
builddir="$startdir"
options="!fetch !check"

package() {
	dest="$pkgdir/usr/share/php/Multilang"
	install -d "$dest"
	cp -r src composer.json "$dest"/
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}
