
# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
.pybuild/
.ruff_cache/

# JavaScript
node_modules/
npm-debug.log*

# PHP
vendor/
composer.lock

# Go build artifacts (source-built binaries, not the module itself)
go/multilang.test
go/conformance.test

# C build artifacts -- never bake host-built binaries into anything;
# always rebuild from source (see .dockerignore for why)
c/*.o
c/*.so
c/src/*.o
c/test/*.o
c/test/test_validation
c/test/test_strings
c/test/test_conformance
c/test/test_cpp

# Local test/example scratch data (e.g. filesystem-backend content roots
# created by running examples/basic_usage.* by hand)
example-strings/
*.sqlite3
*.db

# Native package build output (see each <language>/packaging/README.md --
# these are only ever meant to be produced by CI, but .gitignore them
# anyway in case build-deb.sh/build-rpm.sh is ever run in a local
# container by hand)
dist-packages/
*.deb
*.deb.sha512
*.rpm
*.rpm.sha512
*.orig.tar.gz

# Examples website build output (see website/mkdocs.yml -- only ever
# meant to be produced by .github/workflows/pages.yml, but .gitignore it
# anyway in case `mkdocs build`/`mkdocs serve` is ever run locally)
/site-build/
website/site/

# Editors / OS
.DS_Store
.vscode/
.idea/
*.swp
