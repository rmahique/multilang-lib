# Contributor: Raúl Mahiques <claude.ia@raulmahiques.com>
# Maintainer: Raúl Mahiques <claude.ia@raulmahiques.com>
pkgname=libmultilang
# build-apk.sh exports MULTILANG_VERSION before invoking abuild; 0.1.0
# here is only a fallback for anyone invoking abuild directly.
pkgver=${MULTILANG_VERSION:-0.1.0}
pkgrel=0
pkgdesc="Reusable multi-language string storage library"
url="https://github.com/rmahique/multilang-lib"
arch="all"
license="GPL-3.0-or-later"
makedepends="pkgconf sqlite-dev postgresql-dev openssl-dev mariadb-connector-c-dev"
# subpackages="$pkgname-dev" (no explicit :_dev function) invokes abuild's
# own built-in default_dev() splitter -- it automatically moves
# usr/include and unversioned usr/lib/*.so symlinks into libmultilang-dev
# while leaving the versioned usr/lib/*.so.0* runtime files in this
# package, exactly matching the runtime/headers split
# ../../debian/control and ../../rpm/multilang.spec already do by hand.
# This only works because ../../../Makefile's install-runtime target
# creates the real/versioned .so.0 files and install-devel creates the
# unversioned .so symlink on top -- same layout convention default_dev()
# expects.
subpackages="$pkgname-dev"
# No source= URL: build-apk.sh stages Makefile, src/, include/, README.md,
# and LICENSE alongside this APKBUILD before invoking abuild, same
# tarball-staging idea as ../build-deb.sh/../build-rpm.sh.
source=""
builddir="$startdir"
# abuild's default srcdir is "$startdir/src" -- which, unset, would be
# the exact same path as this project's own src/ directory (staged
# directly into $startdir by ../build-apk.sh). abuild wipes $srcdir
# clean right before running build()/package(), which would silently
# delete the real source files out from under `make install` ("No rule
# to make target 'src/validation.o'"). Pointed at an unused path instead
# -- safe because source="" means abuild never needs to extract anything
# into it.
srcdir="$startdir/.abuild-srcdir-unused"
options="!fetch !check"

# No build(): everything happens in package() via `make install`, which
# does its own compile step first -- same reasoning as
# ../../debian/rules' override_dh_auto_build and ../../rpm/multilang.spec's
# %build (both effectively no-ops for the same reason).

package() {
	make install DESTDIR="$pkgdir" PREFIX=/usr LIBDIR=/usr/lib INCLUDEDIR=/usr/include
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	install -Dm644 README.md "$pkgdir"/usr/share/doc/$pkgname/README.md
}
