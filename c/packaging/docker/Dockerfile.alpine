# Packaging build image for c-alpine. Bakes in every dependency
# packaging/build-apk.sh needs, on the same distro the package targets --
# generated from (and must be kept in sync with) the combo definition in
# ../../../.github/workflows/build-packages.yml.
#
# See python/packaging/README.md's "Alpine" section for why this
# Dockerfile creates a `builder` user and an ephemeral signing key
# instead of just `apk add`-ing and building directly as root, the way
# every other Dockerfile in this repo does -- abuild itself refuses to
# run its build/package steps as root. Package names below are this
# project's own best-effort guess for Alpine's dependency naming (see
# ../../README.md's dependency-names note and c/packaging/README.md's
# Alpine section) -- if a name has moved, only this Dockerfile needs
# updating.
FROM alpine:3.20

RUN apk add --no-cache alpine-sdk sudo pkgconf sqlite-dev postgresql-dev openssl-dev mariadb-connector-c-dev tar git && \
    adduser -D builder && \
    addgroup builder abuild && \
    echo 'builder ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/builder && \
    su builder -c 'abuild-keygen -a -i -n'
