# Runs the shared conformance suite against a real Postgres/MySQL server.
# Build context must be the repo root (needs ../conformance/cases.json):
#   docker build -f javascript/Dockerfile.conformance -t multilang-conformance-js .
#
# NODE_VERSION is a build ARG, not hardcoded, so CI can test any version:
#   docker build --build-arg NODE_VERSION=22 -f javascript/Dockerfile.conformance .
ARG NODE_VERSION=20
FROM node:${NODE_VERSION}-slim

# node-gyp fallback in case a prebuilt better-sqlite3 binary isn't
# available for this exact node/arch combination.
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY conformance/ /app/conformance/
RUN chmod +x /app/conformance/docker/run-both-backends.sh
COPY javascript/ /app/javascript/

WORKDIR /app/javascript
RUN npm install

# The entrypoint runs CMD once against postgres and once against mysql,
# inside this one container -- see run-both-backends.sh. Connection info
# (MULTILANG_PG_HOST/_PORT, MULTILANG_MYSQL_HOST/_PORT,
# MULTILANG_DB_USER/_PASSWORD/_NAME) is supplied at `docker run` time by
# run-live-db-tests.sh.
ENTRYPOINT ["/app/conformance/docker/run-both-backends.sh"]
CMD ["node", "--test", "test/conformance.test.js"]
